+def list_current_objects(client, bucket, batch_size):
+    """List current object versions for servers without versioning support."""
+    kwargs = {'Bucket': bucket, 'MaxKeys': batch_size}
+    truncated = True
+    while truncated:
+        listing = client.list_objects_v2(**kwargs)
+        kwargs['ContinuationToken'] = listing.get('NextContinuationToken')
+        truncated = listing.get('IsTruncated', False)
+        objs = listing.get('Contents', [])
+        if objs:
+            yield [{'Key': o['Key']} for o in objs]
+
